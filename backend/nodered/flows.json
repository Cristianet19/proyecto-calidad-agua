    {
        "id": "2ebd372ba1197135",
        "type": "function",
        "z": "918bfad9227b4858",
        "name": "Alert Counter",
        "func": "\nconst N = 3;   // consecutive CONTAMINATED readings needed to raise the alert\n\nlet count = context.get(\"count\") || 0;\nlet active = context.get(\"active\") || false;\nlet out = null;\n\nif (String(msg.payload).trim() === \"CONTAMINATED\") {\n    count++;\n    if (count >= N && !active) {\n        active = true;\n        out = \"🚨 ALERT: water contaminated\";\n    }\n} else {\n    count = 0;\n    if (active) {\n        active = false;\n        out = \"✅ No alert\";\n    }\n}\n\ncontext.set(\"count\", count);\ncontext.set(\"active\", active);\n\nif (out === null) return null;   // nothing to show: no change\nmsg.payload = out;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
