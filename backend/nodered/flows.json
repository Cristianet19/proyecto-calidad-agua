    {
        "id": "f67d9b98932de3a3",
        "type": "function",
        "z": "918bfad9227b4858",
        "name": "Parse Heartbeat",
        "func": "\nconst p = String(msg.payload).trim();\n\nif (p.startsWith(\"OK\")) {\n    const secs = parseInt(p.split(\" \")[1], 10) || 0;\n    const mins = Math.floor(secs / 60);\n    msg.payload = \"🟢 Board OK · uptime \" + mins + \" min\";\n} else if (p === \"NO_READINGS\") {\n    msg.payload = \"🔴 Board alive, but no sensor readings\";\n} else {\n    return null;   // ignore anything unexpected\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
